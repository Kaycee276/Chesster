COORDINATOR_SECRET_KEY=your_coordinator_secret_key
CORS_ORIGIN=*
ESCROW_CONTRACT_ADDRESS=your_contract_address
PORT=3000
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url

# JWT auth (feat #56)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Shared JWT revocation state (account deletion and session invalidation)
REDIS_URL=redis://localhost:6379

# Stockfish AI bot opponent (feat #57)
# Path/command for a locally installed UCI-speaking Stockfish binary.
# Falls back to a lightweight built-in heuristic bot if unset/unavailable.
STOCKFISH_PATH=stockfish
STOCKFISH_MOVE_TIME_MS=800
STOCKFISH_ANALYSIS_TIMEOUT_MS=15000

# Referral commission payout provider
REFERRAL_PAYOUT_URL=https://payments.example.com/referral-payouts
REFERRAL_PAYOUT_API_KEY=replace_with_provider_api_key
REFERRAL_PAYOUT_TIMEOUT_MS=10000
# Must match the escrow contract's configured fee basis points.
PLATFORM_RAKE_BPS=500

# Redis event bus (falls back to in-memory delivery when unset/unavailable)
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1000

# Tournament notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me
RESEND_API_KEY=re_replace_me
TOURNAMENT_EMAIL_FROM=Chesster <tournaments@chesster.io>
APP_URL=https://chesster.io
# Bot worker pool (feat #241). Engine searches run in worker threads; pool
# size defaults to min(4, CPU cores - 1) and is always capped at the core count.
# BOT_WORKER_POOL_SIZE=4
BOT_MOVE_TIMEOUT_MS=3000
BOT_MAX_QUEUE_SIZE=100

# Weekly completed-game archival (AWS S3 or S3-compatible Cloudflare R2)
ARCHIVE_S3_BUCKET=chesster-archives
ARCHIVE_S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Wager jurisdiction compliance
RESTRICTED_WAGER_COUNTRIES=CU,IR,KP,SY
RESTRICTED_WAGER_REGIONS=US-HI,US-ID,US-LA,US-MI,US-MT,US-NV,US-WA
# proxy-addr names/CIDRs; forwarded headers are ignored for other peers
TRUSTED_PROXIES=loopback

# Match audit export (feat #243). HMAC key used to sign exported audit
# packages; derived from JWT_SECRET when unset. ADMIN_ADDRESSES is a
# comma-separated list of Stellar addresses allowed to export any match.
AUDIT_SIGNING_SECRET=change_me_to_a_long_random_secret
ADMIN_ADDRESSES=
# REDIS_URL also backs profile caching. Cache reads fall back to the database
# when Redis is unavailable; local JWT revocation remains active in-process.
# Outgoing webhooks (feat #246)
# Failed deliveries retry with exponential back-off:
#   delay = min(WEBHOOK_MAX_RETRY_DELAY_MS, WEBHOOK_RETRY_DELAY_MS * 2^attempt + jitter)
# and are archived in the webhook_dead_letter_queue table once attempts run out.
# The table is restricted to the Supabase service role; set this so the backend
# can write to it (never expose it to the frontend).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
WEBHOOK_SECRET=change_me_to_a_long_random_secret
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_MAX_RETRY_DELAY_MS=30000
WEBHOOK_RETRY_JITTER_MS=500
