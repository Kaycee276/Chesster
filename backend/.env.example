COORDINATOR_SECRET_KEY=your_coordinator_secret_key
CORS_ORIGIN=*
ESCROW_CONTRACT_ADDRESS=your_contract_address
PORT=3000
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url

# JWT auth (feat #56)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Stockfish AI bot opponent (feat #57)
# Path/command for a locally installed UCI-speaking Stockfish binary.
# Falls back to a lightweight built-in heuristic bot if unset/unavailable.
STOCKFISH_PATH=stockfish
STOCKFISH_MOVE_TIME_MS=800
# Bot worker pool (feat #241). Engine searches run in worker threads; pool
# size defaults to min(4, CPU cores - 1) and is always capped at the core count.
# BOT_WORKER_POOL_SIZE=4
BOT_MOVE_TIMEOUT_MS=3000
BOT_MAX_QUEUE_SIZE=100
