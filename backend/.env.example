COORDINATOR_SECRET_KEY=your_coordinator_secret_key
CORS_ORIGIN=*
ESCROW_CONTRACT_ADDRESS=your_contract_address
PORT=3000
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=your_supabase_url

# JWT auth (feat #56)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Stockfish AI bot opponent (feat #57)
# Path/command for a locally installed UCI-speaking Stockfish binary.
# Falls back to a lightweight built-in heuristic bot if unset/unavailable.
STOCKFISH_PATH=stockfish
STOCKFISH_MOVE_TIME_MS=800

# Redis profile cache (feat #247). Optional: when unset, or while Redis is
# unreachable, profile queries go straight to the database.
# REDIS_URL=redis://localhost:6379
# Outgoing webhooks (feat #246)
# Failed deliveries retry with exponential back-off:
#   delay = min(WEBHOOK_MAX_RETRY_DELAY_MS, WEBHOOK_RETRY_DELAY_MS * 2^attempt + jitter)
# and are archived in the webhook_dead_letter_queue table once attempts run out.
# The table is restricted to the Supabase service role; set this so the backend
# can write to it (never expose it to the frontend).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
WEBHOOK_SECRET=change_me_to_a_long_random_secret
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_MAX_RETRY_DELAY_MS=30000
WEBHOOK_RETRY_JITTER_MS=500
